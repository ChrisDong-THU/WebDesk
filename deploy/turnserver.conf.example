# Replace all placeholders on the ECS host before starting Coturn.
listening-port=3478
tls-listening-port=5349
listening-ip=ECS_PRIVATE_IP
relay-ip=ECS_PRIVATE_IP
external-ip=ECS_PUBLIC_IP/ECS_PRIVATE_IP
min-port=49160
max-port=49200
realm=turn.example.com
fingerprint
lt-cred-mech
user=webdesk:REPLACE_WITH_RANDOM_SECRET
cert=/etc/turnserver/cert.pem
pkey=/etc/turnserver/key.pem
no-tlsv1
no-tlsv1_1
no-cli
no-multicast-peers
no-tcp-relay
user-quota=12
total-quota=24
stale-nonce=600
# Do not permit relay access to the ECS metadata endpoint or private services.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
syslog
