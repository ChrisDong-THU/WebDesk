      "derived_pseudocode": [
        "fallback = [H265,H264,AV1,VP9,VP8,opus,G722,PCMU,PCMA,CN]",
        "try:",
        "  enabled = videoCodecs.split(\",\")",
        "  ordered = videoCodecsSort.split(\",\")",
        "  common = enabled.where((name) => ordered.contains(name)).toList()",
        "  result = ordered.where((name) => common.contains(name)).toList()",
        "catch: result = fallback",
        "return result"
      ],
      "semantics_limits": [
        "Names in this list are compared by equality; this helper does not measure hardware, bandwidth, encode cost, or receiver decode cost.",
