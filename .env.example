HOST=127.0.0.1
PORT=4300
# Empty for direct access. With the bundled local nginx proxy: 127.0.0.1,::1
TRUSTED_PROXIES=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4300,http://127.0.0.1:4300
# Optional. Without ICE servers, direct connectivity is required.
ICE_SERVERS=[]
# Example: [{"urls":"turn:your-server:3478","username":"webdesk","credential":"replace-me"}]
