diff --git a/src/internal/desktop_capture_policy.h b/src/internal/desktop_capture_policy.h
new file mode 100644
--- /dev/null
+++ b/src/internal/desktop_capture_policy.h
@@ -0,0 +1,86 @@
+#ifndef LIBWEBRTC_INTERNAL_DESKTOP_CAPTURE_POLICY_H_
+#define LIBWEBRTC_INTERNAL_DESKTOP_CAPTURE_POLICY_H_
+
+#include <algorithm>
+#include <cstdint>
+
+namespace libwebrtc {
+namespace capture_policy {
+
+// Backend numbers match RTCDesktopCapturer::Backend. No OS APIs or clock are
+// hidden here: fault recovery and fitting can be tested deterministically.
+class Recovery {
+ public:
+  void Reset(int preferred) { *this = Recovery(); preferred_ = preferred; }
+  void Failure(int64_t now_ms, bool permanent) {
+    if (errors_ < 1000000) ++errors_;
+    if ((permanent || errors_ >= 8) && !pending_) {
+      pending_ = true;
+      next_backend_ = 3;  // Restore delivery with GDI before probing hardware.
+      due_ms_ = std::max(now_ms + 1000, last_rebuild_ms_ + 1000);
+    }
+  }
+  void Frame(int64_t now_ms, int actual) {
+    errors_ = 0;
+    if (actual == 1 || actual == 2 || preferred_ == 3) {
+      degraded_ = pending_ = false;
+      retry_count_ = 0;
+    } else if (actual == 3 && preferred_ != 3) {
+      if (!degraded_ || pending_) due_ms_ = now_ms + 30000;
+      degraded_ = true;
+      pending_ = false;
+      next_backend_ = preferred_;
+    }
+  }
+  bool Due(int64_t now_ms) const {
+    return (pending_ || degraded_) && now_ms >= due_ms_;
+  }
+  int NextBackend() const { return next_backend_; }
+  void Rebuilt(int64_t now_ms, bool success, int backend) {
+    last_rebuild_ms_ = now_ms;
+    errors_ = 0;
+    pending_ = !success;
+    if (!success) {
+      const int shift = std::min(retry_count_++, 5);
+      due_ms_ = now_ms + std::min<int64_t>(30000, int64_t{1000} << shift);
+      next_backend_ = 3;
+      return;
+    }
+    retry_count_ = 0;
+    degraded_ = backend == 3 && preferred_ != 3;
+    next_backend_ = preferred_;
+    due_ms_ = now_ms + 30000;
+  }
+  bool recovering() const { return pending_ || degraded_; }
+  uint32_t errors() const { return errors_; }
+
+ private:
+  int preferred_ = 0;
+  int next_backend_ = 3;
+  uint32_t errors_ = 0;
+  int retry_count_ = 0;
+  int64_t last_rebuild_ms_ = 0;
+  int64_t due_ms_ = 0;
+  bool pending_ = false;
+  bool degraded_ = false;
+};
+
+inline bool Fit(int width, int height, uint32_t max_width, uint32_t max_height,
+                int* output_width, int* output_height) {
+  if (width < 2 || height < 2 || width > 32768 || height > 32768 ||
+      int64_t{width} * height > 40000000) return false;
+  int64_t w = width, h = height;
+  if (max_width && w > max_width) {
+    h = std::max<int64_t>(2, h * max_width / w); w = max_width;
+  }
+  if (max_height && h > max_height) {
+    w = std::max<int64_t>(2, w * max_height / h); h = max_height;
+  }
+  *output_width = static_cast<int>(w) & ~1;
+  *output_height = static_cast<int>(h) & ~1;
+  return *output_width >= 2 && *output_height >= 2;
+}
+
+}  // namespace capture_policy
+}  // namespace libwebrtc
+#endif
