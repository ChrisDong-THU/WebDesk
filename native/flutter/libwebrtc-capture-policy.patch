+    health_.convert_time_us = webrtc::TimeMicros() - started_us;
+    last_frame_ms_ = webrtc::TimeMillis();
+  }
+  OnFrame(webrtc::VideoFrame::Builder().set_video_frame_buffer(buffer)
+      .set_timestamp_us(webrtc::TimeMicros()).set_rotation(webrtc::kVideoRotation_0).build());
+}
