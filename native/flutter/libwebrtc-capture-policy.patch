+RTCDesktopCapturerImpl::~RTCDesktopCapturerImpl() {
+  capture_state_ = CS_STOPPED;
+  ++capture_generation_;
+  // WGC/DXGI resources are created, driven and released on the capture thread.
+  thread_->BlockingCall([this] { capturer_.reset(); });
+  thread_->Stop();
+}
+
+bool RTCDesktopCapturerImpl::SetCapturePolicy(const CapturePolicy& policy) {
+  if (policy.max_width > 32768 || policy.max_height > 32768 ||
+      policy.max_width == 1 || policy.max_height == 1 ||
+      static_cast<int>(policy.backend) < 0 || static_cast<int>(policy.backend) > 3)
+    return false;
+  return thread_->BlockingCall([this, policy] {
+    if (capture_state_ == CS_RUNNING) return false;
+    policy_ = policy;
+    preferred_backend_ = policy.backend;
+    bool supported = true;
+#ifdef WEBRTC_WIN
+    if (policy.backend == Backend::kWgc) {
+#if defined(RTC_ENABLE_WIN_WGC)
+      supported = webrtc::IsWgcSupported(type_ == kScreen ?
+          webrtc::CaptureType::kScreen : webrtc::CaptureType::kWindow);
+#else
+      supported = false;
+#endif
+    }
+    // Desktop duplication does not capture individual windows.
+    if (type_ != kScreen && policy.backend == Backend::kDxgi) supported = false;
+#else
+    supported = policy.backend == Backend::kAuto;
+#endif
+    if (!supported) preferred_backend_ = Backend::kAuto;
+    recovery_.Reset(static_cast<int>(preferred_backend_));
+    std::lock_guard<std::mutex> lock(health_mutex_);
+    health_.requested_backend = policy.backend;
+    health_.fallback_reason = supported ? FallbackReason::kNone :
+                                        FallbackReason::kBackendUnavailable;
+    return true;
+  });
+}
+
+RTCDesktopCapturer::CaptureHealth RTCDesktopCapturerImpl::GetCaptureHealth() {
+  std::lock_guard<std::mutex> lock(health_mutex_);
+  auto health = health_;
+  health.last_frame_age_ms = last_frame_ms_ < 0 ? -1 :
+      std::max<int64_t>(0, webrtc::TimeMillis() - last_frame_ms_);
+  return health;
+}
