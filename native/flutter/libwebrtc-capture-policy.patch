+RTCDesktopCapturer::CaptureState RTCDesktopCapturerImpl::Start(
+    uint32_t fps, uint32_t x, uint32_t y, uint32_t w, uint32_t h) {
+  return thread_->BlockingCall([this, fps, x, y, w, h] {
+    if (capture_state_ == CS_RUNNING) return CS_RUNNING;
+    if (x > 32768 || y > 32768 || w > 32768 || h > 32768) return CS_FAILED;
