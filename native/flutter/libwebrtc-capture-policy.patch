--- /dev/null
+++ b/src/internal/bounded_i420_pool.h
@@ -0,0 +1,33 @@
+#ifndef LIBWEBRTC_INTERNAL_BOUNDED_I420_POOL_H_
+#define LIBWEBRTC_INTERNAL_BOUNDED_I420_POOL_H_
+
+#include <array>
+#include "api/video/i420_buffer.h"
+#include "rtc_base/ref_counted_object.h"
+
+namespace libwebrtc {
+// Unlike VideoFrameBufferPool's dimension purge, these slots keep references
+// to retained old-resolution frames. Repeated resize cannot evade the bound.
+// Owned and used by exactly one capture/conversion thread.
+class BoundedI420Pool {
+ public:
+  webrtc::scoped_refptr<webrtc::I420Buffer> Get(int width, int height) {
+    Slot* available = nullptr;
+    for (auto& slot : slots_) {
+      if (!slot || slot->HasOneRef()) {
+        if (slot && slot->width() == width && slot->height() == height)
+          return slot;
+        if (!available) available = &slot;
+      }
+    }
+    if (!available) return nullptr;
+    *available = webrtc::scoped_refptr<webrtc::RefCountedObject<webrtc::I420Buffer>>(
+        new webrtc::RefCountedObject<webrtc::I420Buffer>(width, height));
+    return *available;
+  }
+ private:
+  using Slot = webrtc::scoped_refptr<webrtc::RefCountedObject<webrtc::I420Buffer>>;
+  std::array<Slot, 4> slots_;
+};
+}  // namespace libwebrtc
+#endif
