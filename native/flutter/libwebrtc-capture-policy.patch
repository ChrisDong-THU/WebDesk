+scoped_refptr<RTCVideoFrame> RTCVideoFrame::CreateFromBgra(
+    int width, int height, const uint8_t* bgra, int stride, int length) {
+  if (!bgra || width < 2 || height < 2 || (width & 1) || (height & 1) ||
+      width > 32768 || height > 32768 || int64_t{width} * height > 40000000 ||
+      stride < width * 4 || length < 0 ||
+      int64_t{stride} * (height - 1) + int64_t{width} * 4 > length)
+    return nullptr;
+  thread_local BoundedI420Pool pool;
+  auto buffer = pool.Get(width, height);
+  if (!buffer || libyuv::ARGBToI420(
+      bgra, stride, buffer->MutableDataY(), buffer->StrideY(),
+      buffer->MutableDataU(), buffer->StrideU(), buffer->MutableDataV(),
+      buffer->StrideV(), width, height) != 0) return nullptr;
+  return scoped_refptr<RTCVideoFrame>(
+      new RefCountedObject<VideoFrameBufferImpl>(buffer));
+}
