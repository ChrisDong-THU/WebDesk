+void FlutterScreenCapture::SetNativeTexture(
+    const std::string& track_id, bool enabled,
+    std::unique_ptr<MethodResultProxy> result) {
+  std::shared_ptr<MethodResultProxy> shared_result(std::move(result));
+  // Capturer destruction and source enumeration already run on this worker.
+  // Never wait for a capture-thread rebuild from the platform/message thread.
+  PostToWorker([this, track_id, enabled, shared_result] {
+    if (closing_) return;
+    scoped_refptr<RTCDesktopCapturer> capturer;
+    {
+      std::lock_guard<std::mutex> lock(capturers_mutex_);
+      const auto found = capture_tracks_.find(track_id);
+      if (found != capture_tracks_.end()) capturer = found->second;
+    }
+    const bool changed = capturer.get() &&
+        capturer->SetNativeTextureEnabled(enabled);
+    PostResult([shared_result, changed] {
+      shared_result->Success(EncodableValue(changed));
+    });
+  });
+}
+
+void FlutterScreenCapture::GetCaptureStats(
+    const std::string& track_id, std::unique_ptr<MethodResultProxy> result) {
+  scoped_refptr<RTCDesktopCapturer> capturer;
+  {
+    std::lock_guard<std::mutex> lock(capturers_mutex_);
+    const auto found = capture_tracks_.find(track_id);
+    if (found != capture_tracks_.end()) capturer = found->second;
+  }
+  if (!capturer.get()) { result->Success(EncodableValue(EncodableMap{})); return; }
+  const auto health = capturer->GetCaptureHealth();
+  const auto backend = [](RTCDesktopCapturer::Backend value) -> std::string {
+    switch (value) {
+      case RTCDesktopCapturer::Backend::kDxgi: return "dxgi";
+      case RTCDesktopCapturer::Backend::kWgc: return "wgc";
+      case RTCDesktopCapturer::Backend::kGdi: return "gdi";
+      default: return "unknown";
+    }
+  };
+  EncodableMap info;
+  info[EncodableValue("backend")] = EncodableValue(backend(health.active_backend));
+  info[EncodableValue("requestedBackend")] = EncodableValue(backend(health.requested_backend));
+  info[EncodableValue("fallbackReason")] = EncodableValue(static_cast<int>(health.fallback_reason));
+  info[EncodableValue("framesCaptured")] = EncodableValue(static_cast<int64_t>(health.frames_captured));
+  info[EncodableValue("framesDelivered")] = EncodableValue(static_cast<int64_t>(health.frames_delivered));
+  info[EncodableValue("framesDropped")] = EncodableValue(static_cast<int64_t>(health.frames_dropped));
+  info[EncodableValue("captureErrors")] = EncodableValue(static_cast<int64_t>(health.capture_errors));
+  info[EncodableValue("consecutiveErrors")] = EncodableValue(static_cast<int64_t>(health.consecutive_errors));
+  info[EncodableValue("rebuilds")] = EncodableValue(static_cast<int64_t>(health.rebuilds));
+  info[EncodableValue("backendSwitches")] = EncodableValue(static_cast<int64_t>(health.backend_switches));
+  info[EncodableValue("lastFrameAgeMs")] = EncodableValue(health.last_frame_age_ms);
+  info[EncodableValue("captureMs")] = EncodableValue(health.capture_time_us / 1000.0);
+  info[EncodableValue("convertMs")] = EncodableValue(health.convert_time_us / 1000.0);
+  info[EncodableValue("sourceWidth")] = EncodableValue(health.source_width);
+  info[EncodableValue("sourceHeight")] = EncodableValue(health.source_height);
+  info[EncodableValue("outputWidth")] = EncodableValue(health.output_width);
+  info[EncodableValue("outputHeight")] = EncodableValue(health.output_height);
+  info[EncodableValue("recovering")] = EncodableValue(health.recovering);
+  info[EncodableValue("nativeTextureActive")] = EncodableValue(health.native_texture_active);
+  info[EncodableValue("nativeTextureFrames")] = EncodableValue(static_cast<int64_t>(health.native_texture_frames));
+  info[EncodableValue("nativeTextureDrops")] = EncodableValue(static_cast<int64_t>(health.native_texture_drops));
+  info[EncodableValue("nativeTextureErrors")] = EncodableValue(static_cast<int64_t>(health.native_texture_errors));
+  info[EncodableValue("nativeTextureUnavailableReason")] = EncodableValue(static_cast<int64_t>(health.native_texture_unavailable_reason));
+  info[EncodableValue("nativeTextureHresult")] = EncodableValue(health.native_texture_hresult);
+  result->Success(EncodableValue(info));
+}
+
 }  // namespace flutter_webrtc_plugin
