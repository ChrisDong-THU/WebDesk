-  }
-#endif
+  if (result != webrtc::DesktopCapturer::Result::SUCCESS || !frame) return;
+  const int source_width = frame->size().width();
+  const int source_height = frame->size().height();
+  const int width = w_ > 0 ? static_cast<int>(w_) : source_width;
+  const int height = h_ > 0 ? static_cast<int>(h_) : source_height;
+  if (width <= 0 || height <= 0 || x_ > static_cast<uint32_t>(source_width) ||
+      y_ > static_cast<uint32_t>(source_height) ||
+      width > source_width - static_cast<int>(x_) ||
+      height > source_height - static_cast<int>(y_)) return;
+
+  // A delivered frame is retained by asynchronous encoders. Never overwrite it.
+  // A bounded pool reuses only unreferenced frames; overload drops capture rather
+  // than allocating an unbounded encoder backlog.
+  auto buffer = buffer_pool_.CreateI420Buffer(width, height);
+  if (!buffer) return;
+  const auto* pixels = frame->data() + static_cast<std::ptrdiff_t>(y_) * frame->stride() +
+                       static_cast<std::ptrdiff_t>(x_) * 4;
+  if (libyuv::ARGBToI420(pixels, frame->stride(),
+                        buffer->MutableDataY(), buffer->StrideY(),
+                        buffer->MutableDataU(), buffer->StrideU(),
+                        buffer->MutableDataV(), buffer->StrideV(), width, height) != 0) return;
+  OnFrame(webrtc::VideoFrame::Builder()
+              .set_video_frame_buffer(buffer)
+              .set_timestamp_us(webrtc::TimeMicros())
+              .set_rotation(webrtc::kVideoRotation_0)
+              .build());
