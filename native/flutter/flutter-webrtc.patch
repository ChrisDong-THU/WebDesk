+#ifdef _WIN32
+  if (method_call.method_name() == "webdeskAudioCreate") {
+    if (!system_audio_.empty()) {
+      result->Error("AudioBusy", "System audio already belongs to a session"); return;
+    }
+    const auto id = GenerateUUID();
+    RTCAudioOptions options;
+    options.echo_cancellation = false;
+    options.auto_gain_control = false;
+    options.noise_suppression = false;
+    auto source = factory_->CreateAudioSource(id.c_str(), RTCAudioSource::SourceType::kCustom, options);
+    auto track = factory_->CreateAudioTrack(source, id.c_str());
+    auto stream = factory_->CreateStream(id.c_str());
+    stream->AddTrack(track);
+    local_streams_[id] = stream; local_tracks_[id] = track;
+    system_audio_[id] = std::make_unique<WebDeskSystemAudio>(source);
+    EncodableMap info;
+    info[EncodableValue("id")] = EncodableValue(id);
+    info[EncodableValue("label")] = EncodableValue(std::string("Windows system audio"));
+    info[EncodableValue("kind")] = EncodableValue(std::string("audio"));
+    info[EncodableValue("enabled")] = EncodableValue(true);
+    EncodableMap response;
+    response[EncodableValue("streamId")] = EncodableValue(id);
+    response[EncodableValue("audioTracks")] = EncodableValue(EncodableList{EncodableValue(info)});
+    response[EncodableValue("videoTracks")] = EncodableValue(EncodableList{});
+    result->Success(EncodableValue(response)); return;
+  }
+  if (method_call.method_name() == "webdeskAudioSetEnabled") {
+    const auto args = GetValue<EncodableMap>(*method_call.arguments());
+    auto it = system_audio_.find(findString(args, "id"));
+    if (it == system_audio_.end()) { result->Error("AudioClosed", "Audio session has ended"); return; }
+    try {
+      const bool enabled = findBoolean(args, "enabled");
+      it->second->SetEnabled(enabled);
+      result->Success(EncodableValue(enabled));
+    } catch (const std::exception& error) { result->Error("SystemAudio", error.what()); }
+    return;
+  }
+  if (method_call.method_name() == "webdeskAudioDispose") {
+    const auto args = GetValue<EncodableMap>(*method_call.arguments());
+    system_audio_.erase(findString(args, "id"));
+    result->Success(); return;
+  }
+  if (method_call.method_name() == "webdeskSecureStart") {
+    const auto args = GetValue<EncodableMap>(*method_call.arguments());
+    const int height = findInt(args, "height"), fps = findInt(args, "fps");
+    if (height < 360 || height > 4320 || fps < 1 || fps > 60 || !secure_captures_.empty()) {
+      result->Error("InvalidCapture", "Invalid or concurrent secure capture"); return;
+    }
+    const auto id = GenerateUUID();
+    auto stream = factory_->CreateStream(id.c_str());
+    auto source = factory_->CreateCustomVideoSource("webdesk-secure", ParseMediaConstraints(EncodableMap{}));
+    auto track = factory_->CreateVideoTrack(source, id.c_str());
+    try {
+      auto capture = std::make_unique<WebDeskSecureCapture>(source, height, fps);
+      stream->AddTrack(track);
+      local_streams_[id] = stream; local_tracks_[id] = track; video_sources_[id] = {source};
+      secure_captures_[id] = std::move(capture);
+      EncodableMap info;
+      info[EncodableValue("id")] = EncodableValue(id);
+      info[EncodableValue("label")] = EncodableValue(id);
+      info[EncodableValue("kind")] = EncodableValue(std::string("video"));
+      info[EncodableValue("enabled")] = EncodableValue(true);
+      EncodableMap response;
+      response[EncodableValue("streamId")] = EncodableValue(id);
+      response[EncodableValue("videoTracks")] = EncodableValue(EncodableList{EncodableValue(info)});
+      response[EncodableValue("audioTracks")] = EncodableValue(EncodableList{});
+      result->Success(EncodableValue(response));
+    } catch (const std::exception& error) { result->Error("SecureCapture", error.what()); }
+    return;
+  }
+  if (method_call.method_name() == "webdeskSecureStop") {
+    const auto args = GetValue<EncodableMap>(*method_call.arguments());
+    secure_captures_.erase(findString(args, "id"));
+    result->Success(); return;
+  }
+  if (method_call.method_name() == "webdeskSecureStatus") {
+    const auto args = GetValue<EncodableMap>(*method_call.arguments());
+    auto it = secure_captures_.find(findString(args, "id"));
+    result->Success(EncodableValue(it != secure_captures_.end() && it->second->healthy())); return;
+  }
+#endif
+
   if (method_call.method_name().compare("createPeerConnection") == 0) {
