+bool RTCDesktopCapturerImpl::SetNativeTextureEnabled(bool enabled) {
+  return thread_->BlockingCall([this, enabled] {
+    if (capture_state_ != CS_RUNNING) return false;
+    if (policy_.allow_native_texture == enabled) {
+#ifdef WEBRTC_WIN
+      return capturer_ != nullptr || native_capturer_ != nullptr;
+#else
+      return capturer_ != nullptr;
+#endif
+    }
+    policy_.allow_native_texture = enabled;
+    // BuildCapturer releases both previous capturers before constructing the
+    // replacement. Retained native frames own their textures independently;
+    // they neither retain duplication nor get overwritten during this switch.
+    recovery_.Reset(static_cast<int>(preferred_backend_));
+    preconvert_gate_.Reset();
+    const bool created = BuildCapturer(preferred_backend_);
+    recovery_.Rebuilt(webrtc::TimeMillis(), created,
+                      static_cast<int>(preferred_backend_));
+    {
+      std::lock_guard<std::mutex> lock(health_mutex_);
+      ++health_.rebuilds;
+      health_.recovering = recovery_.recovering();
+      health_.consecutive_errors = 0;
+      health_.fallback_reason = !created ? FallbackReason::kCreateFailed :
+          (health_.fallback_reason == FallbackReason::kBackendUnavailable ?
+           FallbackReason::kBackendUnavailable : FallbackReason::kNone);
+      if (!created) ++health_.capture_errors;
+    }
+    // Stop() can race while a native constructor runs; never restart its loop.
+    return created && capture_state_ == CS_RUNNING;
+  });
+}
