+        static_cast<int>(mapped.RowPitch), result->MutableDataY(), result->StrideY(),
+        result->MutableDataU(), result->StrideU(), result->MutableDataV(), result->StrideV(),
+        width_, height_);
+    context_->Unmap(staging_.Get(), 0);
+    if (code != 0) return nullptr;
+    readback_ = result;
+    return readback_;
+  }
+  // Only the producer calls ResetReadback, after HasOneRef() proves there are
+  // no readers. No GPU output is reused while an encoder owns the frame.
+  void ResetReadback() { readback_ = nullptr; }
+ protected:
+  ~Buffer() override = default;
+ private:
+  ComPtr<ID3D11Device> device_;
+  ComPtr<ID3D11DeviceContext> context_;
+  ComPtr<ID3D11Texture2D> texture_;
+  ComPtr<ID3D11Texture2D> staging_;
+  const int width_, height_;
+  std::shared_ptr<ReadbackPool> readback_pool_;
+  std::mutex readback_mutex_;
+  webrtc::scoped_refptr<webrtc::I420BufferInterface> readback_;
+};
+
+struct TexturePool {
+  using Slot = webrtc::scoped_refptr<webrtc::RefCountedObject<Buffer>>;
+  std::array<Slot, 4> slots;
+  std::shared_ptr<ReadbackPool> readbacks = std::make_shared<ReadbackPool>();
+};
+
+// Exact device/format capabilities are probed. There is no texture readback on
+// the successful producer path: the D3D11 video processor scales BGRA to NV12.
+class Converter {
+ public:
+  bool Initialize(ComPtr<ID3D11Device> device, ComPtr<ID3D11DeviceContext> context,
+                  int input_width, int input_height, int output_width, int output_height,
+                  std::shared_ptr<TexturePool> pool = nullptr) {
+    if (pool) pool_ = std::move(pool);
+    device_ = std::move(device); context_ = std::move(context);
+    input_width_ = input_width; input_height_ = input_height;
+    output_width_ = output_width; output_height_ = output_height;
+    ComPtr<ID3D10Multithread> protection;
+    if (FAILED(context_.As(&protection))) return false;
+    protection->SetMultithreadProtected(TRUE);
+    if (FAILED(device_.As(&video_device_)) || FAILED(context_.As(&video_context_))) return false;
+    D3D11_VIDEO_PROCESSOR_CONTENT_DESC content{};
+    content.InputFrameFormat = D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE;
+    content.InputFrameRate = {60, 1}; content.OutputFrameRate = {60, 1};
+    content.InputWidth = input_width_; content.InputHeight = input_height_;
+    content.OutputWidth = output_width_; content.OutputHeight = output_height_;
+    content.Usage = D3D11_VIDEO_USAGE_PLAYBACK_NORMAL;
+    if (FAILED(video_device_->CreateVideoProcessorEnumerator(&content, &enumerator_))) return false;
+    UINT input_flags = 0, output_flags = 0;
+    if (FAILED(enumerator_->CheckVideoProcessorFormat(DXGI_FORMAT_B8G8R8A8_UNORM, &input_flags)) ||
+        !(input_flags & D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT) ||
+        FAILED(enumerator_->CheckVideoProcessorFormat(DXGI_FORMAT_NV12, &output_flags)) ||
+        !(output_flags & D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT) ||
+        FAILED(video_device_->CreateVideoProcessor(enumerator_.Get(), 0, &processor_))) return false;
+    video_context_->VideoProcessorSetStreamFrameFormat(processor_.Get(), 0,
+        D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE);
+    const RECT source{0, 0, input_width_, input_height_};
+    const RECT destination{0, 0, output_width_, output_height_};
+    video_context_->VideoProcessorSetStreamSourceRect(processor_.Get(), 0, TRUE, &source);
+    video_context_->VideoProcessorSetStreamDestRect(processor_.Get(), 0, TRUE, &destination);
+    video_context_->VideoProcessorSetOutputTargetRect(processor_.Get(), TRUE, &destination);
+    video_context_->VideoProcessorSetStreamAutoProcessingMode(processor_.Get(), 0, FALSE);
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE rgb{};
+    rgb.RGB_Range = 0; rgb.Nominal_Range = 2; // Full-range BGRA input.
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE nv12{};
+    nv12.YCbCr_Matrix = 0; nv12.Nominal_Range = 1; // BT.601, limited range.
+    video_context_->VideoProcessorSetStreamColorSpace(processor_.Get(), 0, &rgb);
+    video_context_->VideoProcessorSetOutputColorSpace(processor_.Get(), &nv12);
+    return true;
+  }
+  webrtc::scoped_refptr<Buffer> Convert(ID3D11Texture2D* input) {
+    overloaded_ = false;
+    D3D11_TEXTURE2D_DESC source{}; input->GetDesc(&source);
+    if (source.Width != static_cast<UINT>(input_width_) ||
+        source.Height != static_cast<UINT>(input_height_) ||
+        source.Format != DXGI_FORMAT_B8G8R8A8_UNORM) return nullptr;
+    Slot* available = nullptr;
+    for (auto& slot : pool_->slots) {
+      if (!slot || slot->HasOneRef()) { available = &slot; break; }
+    }
+    if (!available) { overloaded_ = true; return nullptr; }
+    overloaded_ = false;
+    if (*available && ((*available)->device() != device_.Get() ||
+        (*available)->width() != output_width_ || (*available)->height() != output_height_))
+      *available = nullptr;
+    if (!*available) {
+      D3D11_TEXTURE2D_DESC desc{};
+      desc.Width = output_width_; desc.Height = output_height_;
+      desc.MipLevels = 1; desc.ArraySize = 1; desc.Format = DXGI_FORMAT_NV12;
+      desc.SampleDesc.Count = 1; desc.Usage = D3D11_USAGE_DEFAULT;
+      desc.BindFlags = D3D11_BIND_RENDER_TARGET;
+      ComPtr<ID3D11Texture2D> texture;
+      if (FAILED(device_->CreateTexture2D(&desc, nullptr, &texture))) return nullptr;
+      *available = webrtc::scoped_refptr<webrtc::RefCountedObject<Buffer>>(
+          new webrtc::RefCountedObject<Buffer>(device_, context_, texture,
+                                               output_width_, output_height_, pool_->readbacks));
+    }
+    (*available)->ResetReadback();
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC input_desc{};
+    input_desc.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    ComPtr<ID3D11VideoProcessorInputView> input_view;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC output_desc{};
+    output_desc.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    ComPtr<ID3D11VideoProcessorOutputView> output_view;
+    if (FAILED(video_device_->CreateVideoProcessorInputView(input, enumerator_.Get(),
+            &input_desc, &input_view)) ||
+        FAILED(video_device_->CreateVideoProcessorOutputView((*available)->texture(),
+            enumerator_.Get(), &output_desc, &output_view))) return nullptr;
+    D3D11_VIDEO_PROCESSOR_STREAM stream{};
+    stream.Enable = TRUE; stream.pInputSurface = input_view.Get();
+    if (FAILED(video_context_->VideoProcessorBlt(processor_.Get(), output_view.Get(),
+                                               0, 1, &stream))) return nullptr;
+    return *available;
+  }
+  bool overloaded() const { return overloaded_; }
+ private:
+  using Slot = webrtc::scoped_refptr<webrtc::RefCountedObject<Buffer>>;
+  std::shared_ptr<TexturePool> pool_ = std::make_shared<TexturePool>();
+  ComPtr<ID3D11Device> device_;
+  ComPtr<ID3D11DeviceContext> context_;
+  ComPtr<ID3D11VideoDevice> video_device_;
+  ComPtr<ID3D11VideoContext> video_context_;
+  ComPtr<ID3D11VideoProcessorEnumerator> enumerator_;
+  ComPtr<ID3D11VideoProcessor> processor_;
+  int input_width_ = 0, input_height_ = 0, output_width_ = 0, output_height_ = 0;
+  bool overloaded_ = false;
+};
+
+// Diagnostic codes are stable, numeric and safe to expose over the plugin.
+// 1..5 are policy guards set by RTCDesktopCapturerImpl.
+struct MonitorSelection {
+  HMONITOR monitor = nullptr;
+  uint32_t count = 0;
+};
+inline BOOL CALLBACK CountDesktopMonitors(HMONITOR monitor, HDC, LPRECT, LPARAM data) {
+  auto* selection = reinterpret_cast<MonitorSelection*>(data);
+  ++selection->count;
+  selection->monitor = monitor;
+  return TRUE;
+}
+inline bool ResolveSingleDesktopMonitor(HMONITOR* monitor, uint32_t* reason) {
+  MonitorSelection selection;
+  if (!EnumDisplayMonitors(nullptr, nullptr, CountDesktopMonitors,
+                           reinterpret_cast<LPARAM>(&selection)) || !selection.count) {
+    *reason = 6; return false;
+  }
+  if (selection.count != 1) { *reason = 7; return false; }
+  MONITORINFO info{}; info.cbSize = sizeof(info);
+  if (!GetMonitorInfoW(selection.monitor, &info)) { *reason = 8; return false; }
+  // Match full-desktop geometry, including a nonzero virtual-desktop origin.
+  // An adapter's active device count is not a count of distinct monitors.
+  if (info.rcMonitor.left != GetSystemMetrics(SM_XVIRTUALSCREEN) ||
+      info.rcMonitor.top != GetSystemMetrics(SM_YVIRTUALSCREEN) ||
+      info.rcMonitor.right - info.rcMonitor.left != GetSystemMetrics(SM_CXVIRTUALSCREEN) ||
+      info.rcMonitor.bottom - info.rcMonitor.top != GetSystemMetrics(SM_CYVIRTUALSCREEN)) {
+    *reason = 7; return false;
+  }
+  *monitor = selection.monitor;
+  *reason = 0;
+  return true;
+}
+
+class Capturer {
+ public:
+  enum class Result { kFrame, kNoFrame, kOverloaded, kError };
+  static std::unique_ptr<Capturer> Create(webrtc::DesktopCapturer::SourceId source,
+                                         uint32_t max_width, uint32_t max_height,
+                                         std::shared_ptr<TexturePool> pool,
+                                         uint32_t* unavailable_reason = nullptr,
+                                         int64_t* error_hresult = nullptr) {
+    auto result = std::unique_ptr<Capturer>(new Capturer());
+    const bool initialized = result->Initialize(source, max_width, max_height, std::move(pool));
+    if (unavailable_reason) *unavailable_reason = initialized ? 0 : result->unavailable_reason_;
+    if (error_hresult) *error_hresult = initialized ? 0 : static_cast<int64_t>(result->error_hresult_);
+    if (!initialized) return nullptr;
+    return result;
+  }
+  ~Capturer() {
+    if (frame_acquired_) duplication_->ReleaseFrame();
+  }
+  Result Capture(webrtc::scoped_refptr<Buffer>* output) {
+    if (full_desktop_ && GetSystemMetrics(SM_CMONITORS) != 1) return Result::kError;
+    if (!pending_texture_) {
+      DXGI_OUTDUPL_FRAME_INFO info{};
+      ComPtr<IDXGIResource> resource;
+      const HRESULT acquired = duplication_->AcquireNextFrame(0, &info, &resource);
+      if (acquired == DXGI_ERROR_WAIT_TIMEOUT) {
+        if (!last_) return Result::kNoFrame;
+        *output = last_; return Result::kFrame;
+      }
+      if (FAILED(acquired)) return Result::kError;
+      frame_acquired_ = true;
+      if (FAILED(resource.As(&pending_texture_))) {
+        duplication_->ReleaseFrame(); frame_acquired_ = false;
+        return Result::kError;
+      }
+    }
+    auto frame = converter_.Convert(pending_texture_.Get());
+    if (!frame && converter_.overloaded()) {
+      // Keep exactly one acquired source surface until a slot is free. If we
+      // released the only dirty update here, a static desktop could thereafter
+      // time out forever while we kept publishing an older image.
+      return Result::kOverloaded;
+    }
+    pending_texture_.Reset();
+    const HRESULT released = duplication_->ReleaseFrame();
+    frame_acquired_ = false;
+    if (!frame || FAILED(released)) return Result::kError;
+    last_ = frame; *output = std::move(frame);
+    return Result::kFrame;
+  }
+  int source_width() const { return width_; }
+  int source_height() const { return height_; }
+ private:
+  bool Initialize(webrtc::DesktopCapturer::SourceId source, uint32_t max_width, uint32_t max_height,
+                  std::shared_ptr<TexturePool> pool) {
+    full_desktop_ = source == -1;
+    HMONITOR selected = nullptr;
+    if (full_desktop_) {
+      if (!ResolveSingleDesktopMonitor(&selected, &unavailable_reason_)) return false;
+    } else if (!webrtc::GetHmonitorFromDeviceIndex(source, &selected) || !selected) {
+      return Fail(8);
+    }
+    ComPtr<IDXGIFactory1> factory;
+    HRESULT status = CreateDXGIFactory1(IID_PPV_ARGS(&factory));
+    if (FAILED(status)) return Fail(9, status);
+    for (UINT a = 0;; ++a) {
+      ComPtr<IDXGIAdapter1> adapter;
+      if (factory->EnumAdapters1(a, &adapter) == DXGI_ERROR_NOT_FOUND) break;
+      if (!adapter) return Fail(10);
+      for (UINT o = 0;; ++o) {
+        ComPtr<IDXGIOutput> output;
+        if (adapter->EnumOutputs(o, &output) == DXGI_ERROR_NOT_FOUND) break;
+        if (!output) return Fail(11);
+        DXGI_OUTPUT_DESC desc{};
+        if (FAILED(output->GetDesc(&desc)) || desc.Monitor != selected) continue;
+        // Rotation and virtual-desktop composition stay on the established CPU
+        // engine path. Never silently capture a different output or orientation.
+        if (!desc.AttachedToDesktop) return Fail(13);
+        if (desc.Rotation != DXGI_MODE_ROTATION_IDENTITY &&
+            desc.Rotation != DXGI_MODE_ROTATION_UNSPECIFIED) return Fail(14);
+        ComPtr<ID3D11Device> device;
+        ComPtr<ID3D11DeviceContext> context;
+        D3D_FEATURE_LEVEL feature{};
+        status = D3D11CreateDevice(adapter.Get(), D3D_DRIVER_TYPE_UNKNOWN, nullptr,
+              D3D11_CREATE_DEVICE_BGRA_SUPPORT | D3D11_CREATE_DEVICE_VIDEO_SUPPORT,
+              nullptr, 0, D3D11_SDK_VERSION, &device, &feature, &context);
+        if (FAILED(status)) return Fail(15, status);
+        ComPtr<IDXGIOutput1> output1;
+        status = output.As(&output1);
+        if (FAILED(status)) return Fail(16, status);
+        status = output1->DuplicateOutput(device.Get(), &duplication_);
+        if (FAILED(status)) return Fail(17, status);
+        DXGI_OUTDUPL_DESC duplicate_desc{}; duplication_->GetDesc(&duplicate_desc);
+        width_ = static_cast<int>(duplicate_desc.ModeDesc.Width);
+        height_ = static_cast<int>(duplicate_desc.ModeDesc.Height);
+        int width = 0, height = 0;
+        if (!capture_policy::Fit(width_, height_, max_width, max_height, &width, &height)) return Fail(18);
+        if (!converter_.Initialize(device, context, width_, height_, width, height, std::move(pool)))
+          return Fail(19);
+        return true;
+      }
+    }
+    return Fail(12);
+  }
+  bool Fail(uint32_t reason, HRESULT status = S_OK) {
+    unavailable_reason_ = reason; error_hresult_ = status; return false;
+  }
+  uint32_t unavailable_reason_ = 0;
+  HRESULT error_hresult_ = S_OK;
+  bool full_desktop_ = false;
+  bool frame_acquired_ = false;
+  ComPtr<ID3D11Texture2D> pending_texture_;
+  int width_ = 0, height_ = 0;
+  ComPtr<IDXGIOutputDuplication> duplication_;
+  Converter converter_;
+  webrtc::scoped_refptr<Buffer> last_;
+};
