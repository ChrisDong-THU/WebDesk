 namespace libwebrtc {
 namespace capture_policy {
+
+// Preserve fractional frame-period credit instead of restarting the interval
+// at every delivered frame. A 16ms capture timer must not halve a 60fps sink.
+class FrameRateGate {
+ public:
+  void Reset() { initialized_ = false; fps_ = 0; deadline_us_ = 0; }
+  bool ShouldDeliver(int64_t now_us, int fps) {
+    if (fps <= 0) { Reset(); return false; }
+    // VideoSinkWants uses INT_MAX for an unconstrained sink. Do not turn that
+    // sentinel into an artificial one-microsecond throttle.
+    if (fps > 1000000) { Reset(); return true; }
+    const int64_t interval_us = (int64_t{1000000} + fps - 1) / fps;
+    if (!initialized_ || fps != fps_ || now_us < last_sample_us_) {
+      fps_ = fps;
+      deadline_us_ = now_us;
+      initialized_ = true;
+    }
+    last_sample_us_ = now_us;
+    if (now_us < deadline_us_) return false;
+    // A pause/slow consumer cannot save up an unbounded burst of frame credit.
+    // Keep sub-period lateness, so integer capture ticks retain their phase.
+    if (now_us - deadline_us_ >= interval_us) deadline_us_ = now_us;
+    deadline_us_ += interval_us;
+    return true;
+  }
+ private:
+  bool initialized_ = false;
+  int fps_ = 0;
+  int64_t deadline_us_ = 0;
+  int64_t last_sample_us_ = 0;
+};
 
