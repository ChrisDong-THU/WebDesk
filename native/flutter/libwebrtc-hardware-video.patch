@@ -0,0 +1,24 @@
+// Copyright 2026 WebDesk contributors. SPDX-License-Identifier: BSD-3-Clause
+#ifndef LIBWEBRTC_DESKTOP_D3D11_BUFFER_H_
+#define LIBWEBRTC_DESKTOP_D3D11_BUFFER_H_
+#ifdef WEBRTC_WIN
+#include <d3d11.h>
+#include "api/video/video_frame_buffer.h"
+
+namespace webrtc {
+// Optional adapter-matched NV12 capture surface. A producer must keep pixels
+// immutable for the whole referenced frame lifetime and implement ToI420() for
+// unsupported MFTs/software fallback. No claim of GPU capture is made by merely
+// providing this interface. The texture owns its D3D11 device association.
+class DesktopD3D11Buffer : public VideoFrameBuffer {
+ public:
+  Type type() const final { return Type::kNative; }
+  std::string storage_representation() const final { return "WebDesk.D3D11.NV12"; }
+  virtual ID3D11Texture2D* texture() const = 0;
+  virtual UINT subresource() const = 0;
+ protected:
+  ~DesktopD3D11Buffer() override = default;
+};
+}  // namespace webrtc
+#endif
+#endif
