+class Sink final : public EncodedImageCallback {
+ public:
+  Result OnEncodedImage(const EncodedImage& frame, const CodecSpecificInfo* codec) override {
+    ++frames;
+    last_timestamp = frame.RtpTimestamp();
+    last_codec = codec->codecType;
+    temporal = codec->codecSpecific.H264.temporal_idx;
+    last_key = frame._frameType == VideoFrameType::kVideoFrameKey;
+    key |= last_key;
+    keyframes += last_key ? 1 : 0;
+    return Result(Result::OK);
+  }
+  void OnFrameDropped(uint32_t, int, bool) override {}
+  int frames = 0;
+  uint32_t last_timestamp = 0;
+  VideoCodecType last_codec = kVideoCodecGeneric;
+  bool key = false;
+  bool last_key = false;
+  int keyframes = 0;
+  uint8_t temporal = 0;
+};
+VideoFrame Frame(uint32_t timestamp) {
+  auto buffer = I420Buffer::Create(640, 360);
+  I420Buffer::SetBlack(buffer.get());
+  return VideoFrame::Builder().set_video_frame_buffer(buffer)
+      .set_timestamp_us(timestamp * 1000LL / 90).set_rtp_timestamp(timestamp).build();
+}
+const VideoEncoder::Settings settings(VideoEncoder::Capabilities(false), 4, 1200);
+
+TEST(WebDeskH264, RejectsUnimplementedFormatsWithoutInventingCapabilities) {
+  EXPECT_TRUE(WebDeskHardwareH264Format(Baseline()));
+  auto single_nal = Baseline();
+  single_nal.parameters["packetization-mode"] = "0";
+  EXPECT_FALSE(WebDeskHardwareH264Format(single_nal));
+  EXPECT_FALSE(WebDeskHardwareH264Format(SdpVideoFormat("VP8")));
+  auto invalid = Baseline();
+  invalid.parameters["profile-level-id"] = "f4001f";
+  EXPECT_FALSE(WebDeskHardwareH264Format(invalid));
+}
+
+TEST(WebDeskH264, CapabilityProbeIsNonblockingAndCached) {
+  const auto started = std::chrono::steady_clock::now();
+  for (int i = 0; i < 100; ++i) WebDeskHasHardwareH264();
+  EXPECT_LT(std::chrono::steady_clock::now() - started, std::chrono::milliseconds(100));
+}
+
+TEST(WebDeskH264, ProcessDisableSwitchBypassesProbeAndHardwareSelection) {
+  wchar_t value[4] = {};
+  if (GetEnvironmentVariableW(L"WEBDESK_DISABLE_HARDWARE_H264", value, 4) != 1 || value[0] != L'1')
+    GTEST_SKIP() << "Run with WEBDESK_DISABLE_HARDWARE_H264=1 for the process-level fallback test";
+  EXPECT_FALSE(WebDeskHasHardwareH264());
+  EXPECT_TRUE(WebDeskHardwareVideoProbeComplete());
+  auto format = Baseline();
+  auto factory = CreateWebDeskHardwareVideoEncoderFactory(CreateBuiltinVideoEncoderFactory());
+  auto encoder = factory->Create(CreateEnvironment(), format);
+  ASSERT_TRUE(encoder);
+  auto codec = Codec();
+  ASSERT_EQ(encoder->InitEncode(&codec, settings), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_FALSE(encoder->GetEncoderInfo().is_hardware_accelerated);
+  encoder->Release();
+}
+
+TEST(WebDeskH264, HardwareInitRejectionFallsBackToSameCodecAndReportsSoftware) {
+  auto env = CreateEnvironment();
+  auto format = Baseline();
+  // Packetization mode 0 is intentionally not handled by the hardware adapter,
+  // but remains a real builtin H264 format. This deterministically exercises
+  // our init rejection and the exact wrapper used by HardwareFactory.
+  format.parameters["packetization-mode"] = "0";
+  auto builtin = CreateBuiltinVideoEncoderFactory();
+  auto software = builtin->Create(env, format);
+  ASSERT_TRUE(software);
+  auto encoder = CreateVideoEncoderSoftwareFallbackWrapper(env, std::move(software),
+      CreateWebDeskHardwareH264(format), false);
+  Sink sink;
+  encoder->RegisterEncodeCompleteCallback(&sink);
+  auto codec = Codec();
+  ASSERT_EQ(encoder->InitEncode(&codec, settings), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_FALSE(encoder->GetEncoderInfo().is_hardware_accelerated);
+  EXPECT_NE(encoder->GetEncoderInfo().implementation_name, "WebDesk-MF-H264");
+  const std::vector<VideoFrameType> key{VideoFrameType::kVideoFrameKey};
+  ASSERT_EQ(encoder->Encode(Frame(9000), &key), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_GT(sink.frames, 0);
+  EXPECT_EQ(sink.last_timestamp, 9000u);
+  EXPECT_EQ(sink.last_codec, kVideoCodecH264);
+  EXPECT_TRUE(sink.key);
+  encoder->Release();
+}
+
+TEST(WebDeskH264, HardwareSmokeEncodesRealFrameWhenDeviceSupportsBaseline) {
+  const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!WebDeskHardwareVideoProbeComplete() && std::chrono::steady_clock::now() < until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  if (!WebDeskHasHardwareH264()) GTEST_SKIP() << "No activated hardware NV12 H264 MFT (or probe pending)";
+  auto encoder = CreateWebDeskHardwareH264(Baseline());
+  Sink sink;
+  encoder->RegisterEncodeCompleteCallback(&sink);
+  auto codec = Codec();
+  if (encoder->InitEncode(&codec, settings) != WEBRTC_VIDEO_CODEC_OK)
+    GTEST_SKIP() << "Hardware exists but rejects requested baseline NV12 configuration; production uses software";
+  EXPECT_TRUE(encoder->GetEncoderInfo().is_hardware_accelerated);
+  EXPECT_EQ(encoder->GetEncoderInfo().implementation_name, "WebDesk-MF-H264-CPU-NV12");
+  const std::vector<VideoFrameType> key{VideoFrameType::kVideoFrameKey};
+  ASSERT_EQ(encoder->Encode(Frame(12000), &key), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(sink.frames, 1);
+  EXPECT_EQ(sink.last_timestamp, 12000u);
+  EXPECT_EQ(sink.last_codec, kVideoCodecH264);
+  EXPECT_TRUE(sink.key);
+  for (uint32_t i = 1; i <= 12; ++i)
+    ASSERT_EQ(encoder->Encode(Frame(12000 + i * 3000), nullptr), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(sink.frames, 13);
+  // Cover both supported CPU pixel formats. Typed WebRTC getters are CHECKs,
+  // so probing GetNV12() on I420 would crash the first frame above.
+  auto nv12 = NV12Buffer::Create(640, 360);
+  nv12->InitializeData();
+  auto nv12_frame = VideoFrame::Builder().set_video_frame_buffer(nv12)
+      .set_timestamp_us(2000000).set_rtp_timestamp(180000).build();
+  ASSERT_EQ(encoder->Encode(nv12_frame, nullptr), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(sink.frames, 14);
+  // A second request on the same live MFT must produce a fresh IDR, not merely
+  // pass because the encoder's first frame happened to be a keyframe.
+  ASSERT_EQ(encoder->Encode(Frame(186000), &key), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(sink.frames, 15);
+  EXPECT_EQ(sink.last_timestamp, 186000u);
+  EXPECT_EQ(sink.temporal, kNoTemporalIdx);
+  EXPECT_TRUE(sink.last_key);
+  EXPECT_GE(sink.keyframes, 2);
+  encoder->Release();
+}
+
+TEST(WebDeskH264, LiveRatesKeepWorkingWhenHardwarePropertyIsReadOnly) {
+  const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!WebDeskHardwareVideoProbeComplete() && std::chrono::steady_clock::now() < until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  if (!WebDeskHasHardwareH264()) GTEST_SKIP() << "No hardware MFT available";
+  auto env = CreateEnvironment();
+  auto format = Baseline();
+  auto builtin = CreateBuiltinVideoEncoderFactory();
+  auto software = builtin->Create(env, format);
+  ASSERT_TRUE(software);
+  auto encoder = CreateVideoEncoderSoftwareFallbackWrapper(env, std::move(software),
+      CreateWebDeskHardwareH264(format), false);
+  auto codec = Codec();
+  Sink sink;
+  encoder->RegisterEncodeCompleteCallback(&sink);
+  ASSERT_EQ(encoder->InitEncode(&codec, settings), WEBRTC_VIDEO_CODEC_OK);
+  const std::vector<VideoFrameType> key{VideoFrameType::kVideoFrameKey};
+  ASSERT_EQ(encoder->Encode(Frame(9000), &key), WEBRTC_VIDEO_CODEC_OK);
+  VideoBitrateAllocation rates;
+  rates.SetBitrate(0, 0, 500000);
+  encoder->SetRates(VideoEncoder::RateControlParameters(rates, 30));
+  for (uint32_t i = 1; i <= 5; ++i)
+    ASSERT_EQ(encoder->Encode(Frame(9000 + i * 3000), i == 5 ? &key : nullptr), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(sink.frames, 6);
+  EXPECT_EQ(sink.last_timestamp, 24000u);
+  EXPECT_TRUE(sink.last_key);
+  EXPECT_EQ(sink.last_codec, kVideoCodecH264);
+  // The native implementation can retain HW on drivers with a working live
+  // rate API. On this machine its read-only property produces builtin H264.
+  std::cout << "Rate-controlled implementation: " << encoder->GetEncoderInfo().implementation_name << std::endl;
+  encoder->Release();
+}
