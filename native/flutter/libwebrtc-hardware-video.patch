+namespace webrtc {
+// Preserves the supplied formats and decoder compatibility. Unsupported MF
+// profiles and hardware failures use the supplied same-format software encoder.
+std::unique_ptr<VideoEncoderFactory> CreateWebDeskHardwareVideoEncoderFactory(
+    std::unique_ptr<VideoEncoderFactory> software);
+// Enumerates and activates Windows hardware transforms on a private COM thread.
+// This is availability, not a guarantee for an arbitrary resolution/profile.
+bool WebDeskHasHardwareH264();
+bool WebDeskHardwareVideoProbeComplete();
+bool WebDeskHardwareH264Format(const SdpVideoFormat& format);
+std::unique_ptr<VideoEncoder> CreateWebDeskHardwareH264(
+    const SdpVideoFormat& format);
+}  // namespace webrtc
