diff --git a/src/win/webdesk_h264_encoder.cc b/src/win/webdesk_h264_encoder.cc
new file mode 100644
--- /dev/null
+++ b/src/win/webdesk_h264_encoder.cc
@@ -0,0 +1,785 @@
+// Copyright 2026 WebDesk contributors. SPDX-License-Identifier: BSD-3-Clause
+// Independent implementation using public Windows Media Foundation APIs.
+#include "src/win/webdesk_h264_encoder.h"
+
+#include <codecapi.h>
+#include <d3d10_1.h>
+#include <d3d11.h>
+#include <mfapi.h>
+#include <mferror.h>
+#include <mfidl.h>
+#include <mftransform.h>
+#include <strmif.h>
+#include <wrl/client.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <map>
+#include <span>
+#include <thread>
+#include <vector>
+#include "include/rtc_desktop_d3d11_buffer.h"
+#include "absl/strings/match.h"
+#include "api/video/encoded_image.h"
+#include "api/video/video_frame.h"
+#include "api/video_codecs/h264_profile_level_id.h"
+#include "api/video_codecs/builtin_video_encoder_factory.h"
+#include "api/video_codecs/video_encoder_software_fallback_wrapper.h"
+#include "common_video/h264/h264_bitstream_parser.h"
+#include "common_video/h264/h264_common.h"
+#include "modules/video_coding/include/video_codec_interface.h"
+#include "modules/video_coding/include/video_error_codes.h"
+#include "modules/video_coding/codecs/interface/common_constants.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/thread.h"
+#include "third_party/libyuv/include/libyuv/convert.h"
+
+namespace webrtc {
+namespace {
+using Microsoft::WRL::ComPtr;
+constexpr size_t kMaxPending = 4;
+constexpr auto kMftDeadline = std::chrono::milliseconds(100);
+// One asynchronous process-wide probe. Snapshot access never runs driver COM
+// code on the GUI/signaling thread and never waits for a stalled driver.
+std::atomic<int> g_probe{0};  // 0 unstarted, 1 pending, 2 unavailable, 3 available
+bool HardwareDisabled() {
+  static const bool disabled = [] {
+    wchar_t value[4] = {};
+    return GetEnvironmentVariableW(L"WEBDESK_DISABLE_HARDWARE_H264", value, 4) == 1 && value[0] == L'1';
+  }();
+  return disabled;
+}
+
+// Hardware-only enumeration is the authority. Never call an async software MFT
+// hardware, and never identify an encoder from GPU vendor/codec name alone.
+HRESULT ActivateHardware(ComPtr<IMFTransform>* result) {
+  MFT_REGISTER_TYPE_INFO input = {MFMediaType_Video, MFVideoFormat_NV12};
+  MFT_REGISTER_TYPE_INFO output = {MFMediaType_Video, MFVideoFormat_H264};
+  IMFActivate** list = nullptr;
+  UINT32 count = 0;
+  HRESULT hr = MFTEnumEx(MFT_CATEGORY_VIDEO_ENCODER,
+                        MFT_ENUM_FLAG_HARDWARE | MFT_ENUM_FLAG_SORTANDFILTER,
+                        &input, &output, &list, &count);
+  if (SUCCEEDED(hr)) {
+    hr = MF_E_TOPO_CODEC_NOT_FOUND;
+    for (UINT32 i = 0; i < count; ++i) {
+      if (SUCCEEDED(list[i]->ActivateObject(IID_PPV_ARGS(result->ReleaseAndGetAddressOf())))) {
+        hr = S_OK;
+        break;
+      }
+    }
+  }
+  for (UINT32 i = 0; i < count; ++i) list[i]->Release();
+  CoTaskMemFree(list);
+  return hr;
+}
+
+HRESULT SetCodecValue(IMFTransform* transform, const GUID& key, ULONG value,
+                   bool boolean = false) {
+  ComPtr<ICodecAPI> api;
+  HRESULT hr = transform->QueryInterface(IID_PPV_ARGS(&api));
+  if (FAILED(hr)) return hr;
+  VARIANT v;
+  VariantInit(&v);
+  v.vt = boolean ? VT_BOOL : VT_UI4;
+  if (boolean) v.boolVal = value ? VARIANT_TRUE : VARIANT_FALSE;
+  else v.ulVal = value;
+  // Optional driver controls: unsupported properties must not disable encoding.
+  return api->SetValue(&key, &v);
+}
+
+void LogRateControl(IMFTransform* transform) {
+  ComPtr<ICodecAPI> api;
+  if (FAILED(transform->QueryInterface(IID_PPV_ARGS(&api)))) return;
+  VARIANT mode, rate;
+  VariantInit(&mode); VariantInit(&rate);
+  const HRESULT mode_hr = api->GetValue(&CODECAPI_AVEncCommonRateControlMode, &mode);
+  const HRESULT rate_hr = api->GetValue(&CODECAPI_AVEncCommonMeanBitRate, &rate);
+  RTC_LOG(LS_INFO) << "WebDesk MF H264 rate readback mode_hr=" << static_cast<long>(mode_hr)
+      << " mode=" << (mode.vt == VT_UI4 ? mode.ulVal : 999u)
+      << " rate_hr=" << static_cast<long>(rate_hr)
+      << " bps=" << (rate.vt == VT_UI4 ? rate.ulVal : 0u);
+  VariantClear(&mode); VariantClear(&rate);
+}
+
+std::optional<uint32_t> ReadMeanBitrate(IMFTransform* transform) {
+  ComPtr<ICodecAPI> api;
+  if (FAILED(transform->QueryInterface(IID_PPV_ARGS(&api)))) return std::nullopt;
+  VARIANT value;
+  VariantInit(&value);
+  const HRESULT hr = api->GetValue(&CODECAPI_AVEncCommonMeanBitRate, &value);
+  std::optional<uint32_t> rate;
+  if (hr == S_OK && value.vt == VT_UI4) rate = value.ulVal;
+  VariantClear(&value);
+  return rate;
+}
+
+int MfProfile(H264Profile profile) {
+  switch (profile) {
+    case H264Profile::kProfileConstrainedBaseline: return eAVEncH264VProfile_ConstrainedBase;
+    case H264Profile::kProfileBaseline: return eAVEncH264VProfile_Base;
+    case H264Profile::kProfileMain: return eAVEncH264VProfile_Main;
+    case H264Profile::kProfileHigh: return eAVEncH264VProfile_High;
+    case H264Profile::kProfileConstrainedHigh: return eAVEncH264VProfile_ConstrainedHigh;
+    default: return 0;
+  }
+}
+
+// Returns Annex B without changing SPS constraints or codec identity. Some MFTs
+// return 4-byte length-prefixed NALs despite the H264 media subtype.
+bool AnnexB(std::span<const uint8_t> bytes, std::vector<uint8_t>* out) {
+  if (bytes.size() >= 4 && bytes[0] == 0 && bytes[1] == 0 &&
+      (bytes[2] == 1 || (bytes[2] == 0 && bytes[3] == 1))) {
+    out->assign(bytes.begin(), bytes.end());
+    return true;
+  }
+  out->clear();
+  size_t offset = 0;
+  while (offset + 4 <= bytes.size()) {
+    size_t size = (static_cast<size_t>(bytes[offset]) << 24) |
+                  (static_cast<size_t>(bytes[offset + 1]) << 16) |
+                  (static_cast<size_t>(bytes[offset + 2]) << 8) | bytes[offset + 3];
+    offset += 4;
+    if (!size || size > bytes.size() - offset) return false;
+    out->insert(out->end(), {0, 0, 0, 1});
+    out->insert(out->end(), bytes.begin() + offset, bytes.begin() + offset + size);
+    offset += size;
+  }
+  return offset == bytes.size() && !out->empty();
+}
+
+class HardwareH264 final : public VideoEncoder {
+ public:
+  explicit HardwareH264(const SdpVideoFormat& format)
+      : format_(format), thread_(Thread::Create()) { thread_->Start(); }
+  ~HardwareH264() override { Release(); thread_->Stop(); }
+  int InitEncode(const VideoCodec* codec, const Settings&) override {
+    if (!codec) return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    const VideoCodec copy = *codec;
+    return thread_->BlockingCall([this, copy] {
+      Cleanup();
+      gpu_rejected_ = false;
+      if (!WebDeskHardwareH264Format(format_) || copy.codecType != kVideoCodecH264 ||
+          copy.width < 2 || copy.height < 2 || (copy.width & 1) || (copy.height & 1) ||
+          static_cast<int64_t>(copy.width) * copy.height > 3840LL * 2160 ||
+          copy.numberOfSimulcastStreams > 1 || copy.H264().numberOfTemporalLayers > 1)
+        return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+      width_ = copy.width; height_ = copy.height;
+      fps_ = std::clamp<uint32_t>(copy.maxFramerate, 1, 120);
+      bitrate_ = std::max<uint32_t>(copy.startBitrate * 1000, 10000);
+      const HRESULT hr = Initialize();
+      if (FAILED(hr)) {
+        RTC_LOG(LS_WARNING) << "WebDesk MF H264 init failed, software fallback HRESULT=" << static_cast<long>(hr);
+        Cleanup();
+        return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+      }
+      active_ = true;
+      return WEBRTC_VIDEO_CODEC_OK;
+    });
+  }
+  int RegisterEncodeCompleteCallback(EncodedImageCallback* callback) override {
+    thread_->BlockingCall([&] { callback_ = callback; });
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int Encode(const VideoFrame& frame, const std::vector<VideoFrameType>* types) override {
+    const bool key = (types && std::find(types->begin(), types->end(),
+                                 VideoFrameType::kVideoFrameKey) != types->end());
+    return thread_->BlockingCall([&, key] {
+      if (!active_ || !callback_) return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+      if (rates_failed_) return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+      if (paused_) return WEBRTC_VIDEO_CODEC_OK;
+      HRESULT hr = EncodeFrame(frame, key || first_);
+      if (FAILED(hr) && device_) {
+        Cleanup(); gpu_rejected_ = true;
+        hr = Initialize();
+        if (SUCCEEDED(hr)) {
+          active_ = true;
+          hr = EncodeFrame(frame, true);
+        }
+      }
+      if (FAILED(hr)) {
+        RTC_LOG(LS_WARNING) << "WebDesk MF H264 encode failed, software fallback HRESULT=" << static_cast<long>(hr);
+        active_ = false;
+        return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+      }
+      first_ = false;
+      return WEBRTC_VIDEO_CODEC_OK;
+    });
+  }
+  void SetRates(const RateControlParameters& rates) override {
+    thread_->BlockingCall([&] {
+      paused_ = rates.bitrate.get_sum_bps() == 0;
+      if (!encoder_ || paused_) return;
+      const uint32_t previous = bitrate_;
+      bitrate_ = rates.bitrate.get_sum_bps();
+      if (rates.framerate_fps > 0)
+        fps_ = std::clamp<uint32_t>(static_cast<uint32_t>(rates.framerate_fps), 1, 120);
+      // Congestion control must be effective, not merely logged. If a driver
+      // rejects live rates, the next input switches to same-format software.
+      const HRESULT rate_hr = SetCodecValue(encoder_.Get(), CODECAPI_AVEncCommonMeanBitRate, bitrate_);
+      // ICodecAPI uses S_FALSE for a read-only parameter. SUCCEEDED(S_FALSE)
+      // must never be mistaken for live congestion-control support.
+      rates_failed_ = rate_hr != S_OK;
+      if (!rates_failed_ && rate_readback_pending_ == 0) rate_readback_pending_ = 2;
+      const uint32_t difference = bitrate_ > previous ? bitrate_ - previous : previous - bitrate_;
+      if (rates_failed_ || difference > previous / 10) {
+        RTC_LOG(LS_INFO) << "WebDesk MF H264 requested bitrate=" << bitrate_
+                        << " SetValue HRESULT=" << static_cast<long>(rate_hr);
+        LogRateControl(encoder_.Get());
+      }
+    });
+  }
+  EncoderInfo GetEncoderInfo() const override {
+    EncoderInfo info;
+    info.implementation_name = texture_active_.load()
+        ? "WebDesk-MF-H264-D3D11" : "WebDesk-MF-H264-CPU-NV12";
+    info.is_hardware_accelerated = active_.load();
+    info.supports_native_handle = true;  // Known NV12 textures, otherwise ToI420.
+    info.supports_simulcast = false;
+    info.requested_resolution_alignment = 2;
+    info.scaling_settings = ScalingSettings(24, 37);
+    info.preferred_pixel_formats = {VideoFrameBuffer::Type::kNV12, VideoFrameBuffer::Type::kI420};
+    return info;
+  }
+  int Release() override {
+    thread_->BlockingCall([this] { Cleanup(); });
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+ private:
+  HRESULT Initialize(ID3D11Device* device = nullptr) {
+    HRESULT hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+    if (FAILED(hr)) return hr;
+    com_ = true;
+    hr = MFStartup(MF_VERSION, MFSTARTUP_LITE);
+    if (FAILED(hr)) return hr;
+    mf_ = true;
+    hr = ActivateHardware(&encoder_);
+    if (FAILED(hr)) return hr;
+    ComPtr<IMFAttributes> attributes;
+    hr = encoder_->GetAttributes(&attributes);
+    if (FAILED(hr)) return hr;
+    UINT32 async = 0;
+    attributes->GetUINT32(MF_TRANSFORM_ASYNC, &async);
+    async_ = async != 0;
+    if (async_) {
+      hr = attributes->SetUINT32(MF_TRANSFORM_ASYNC_UNLOCK, TRUE);
+      if (FAILED(hr)) return hr;
+      hr = encoder_.As(&events_);
+      if (FAILED(hr)) return hr;
+    }
+    attributes->SetUINT32(MF_LOW_LATENCY, TRUE);
+    if (device) {
+      UINT32 aware = 0;
+      if (FAILED(attributes->GetUINT32(MF_SA_D3D11_AWARE, &aware)) || !aware) return E_NOINTERFACE;
+      UINT token = 0;
+      hr = MFCreateDXGIDeviceManager(&token, &manager_);
+      if (FAILED(hr)) return hr;
+      hr = manager_->ResetDevice(device, token);
+      if (FAILED(hr)) return hr;
+      ComPtr<ID3D10Multithread> multithread;
+      if (SUCCEEDED(device->QueryInterface(IID_PPV_ARGS(&multithread))))
+        multithread->SetMultithreadProtected(TRUE);
+      hr = encoder_->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER,
+          reinterpret_cast<ULONG_PTR>(manager_.Get()));
+      if (FAILED(hr)) return hr;
+      device_ = device;
+    } else {
+      encoder_->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER, 0);
+    }
+    DWORD inputs = 0, outputs = 0;
+    hr = encoder_->GetStreamCount(&inputs, &outputs);
+    if (FAILED(hr) || inputs != 1 || outputs != 1) return E_FAIL;
+    hr = encoder_->GetStreamIDs(1, &input_id_, 1, &output_id_);
+    if (hr == E_NOTIMPL) { input_id_ = 0; output_id_ = 0; }
+    else if (FAILED(hr)) return hr;
+    SetCodecValue(encoder_.Get(), CODECAPI_AVLowLatencyMode, TRUE, true);
+    SetCodecValue(encoder_.Get(), CODECAPI_AVEncCommonRateControlMode, eAVEncCommonRateControlMode_CBR);
+    SetCodecValue(encoder_.Get(), CODECAPI_AVEncMPVDefaultBPictureCount, 0);
+    SetCodecValue(encoder_.Get(), CODECAPI_AVEncCommonQualityVsSpeed, 33);
+    SetCodecValue(encoder_.Get(), CODECAPI_AVEncMPVGOPSize, fps_ * 2);
+    auto profile = ParseSdpForH264ProfileLevelId(format_.parameters);
+    if (!profile) return E_INVALIDARG;
+    ComPtr<IMFMediaType> output;
+    hr = MFCreateMediaType(&output);
+    if (FAILED(hr)) return hr;
+    output->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+    output->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
+    MFSetAttributeSize(output.Get(), MF_MT_FRAME_SIZE, width_, height_);
+    MFSetAttributeRatio(output.Get(), MF_MT_FRAME_RATE, fps_, 1);
+    MFSetAttributeRatio(output.Get(), MF_MT_PIXEL_ASPECT_RATIO, 1, 1);
+    output->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    output->SetUINT32(MF_MT_AVG_BITRATE, bitrate_);
+    output->SetUINT32(MF_MT_MPEG2_PROFILE, MfProfile(profile->profile));
+    // Let the MFT pick the level required for the actual dimensions/rate. The
+    // receiver's level-asymmetry setting is negotiated by WebRTC, not rewritten.
+    hr = encoder_->SetOutputType(output_id_, output.Get(), 0);
+    if (FAILED(hr)) return hr;
+    ComPtr<IMFMediaType> input;
+    hr = MFCreateMediaType(&input);
+    if (FAILED(hr)) return hr;
+    input->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+    input->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_NV12);
+    MFSetAttributeSize(input.Get(), MF_MT_FRAME_SIZE, width_, height_);
+    MFSetAttributeRatio(input.Get(), MF_MT_FRAME_RATE, fps_, 1);
+    MFSetAttributeRatio(input.Get(), MF_MT_PIXEL_ASPECT_RATIO, 1, 1);
+    input->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    hr = encoder_->SetInputType(input_id_, input.Get(), 0);
+    if (FAILED(hr)) return hr;
+    SetCodecValue(encoder_.Get(), CODECAPI_AVEncCommonMeanBitRate, bitrate_);
+    LogRateControl(encoder_.Get());
+    hr = encoder_->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+    if (FAILED(hr)) return hr;
+    hr = encoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+    if (FAILED(hr)) return hr;
+    return encoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+  }
+
+  struct Timing {
+    uint32_t rtp; int64_t us; int64_t ntp; int64_t started_ms;
+    // The producer's texture pool uses VideoFrameBuffer references, not the
+    // IMF sample's separate texture COM reference, to decide when reuse is safe.
+    scoped_refptr<VideoFrameBuffer> source;
+    bool key_requested;
+  };
+  HRESULT Submit(const VideoFrame& frame, bool key) {
+    if (frame.width() != width_ || frame.height() != height_) return E_INVALIDARG;
+    ComPtr<IMFSample> sample;
+    HRESULT hr = MFCreateSample(&sample);
+    if (FAILED(hr)) return hr;
+    ComPtr<IMFMediaBuffer> buffer;
+    const DWORD size = width_ * height_ * 3 / 2;
+    const auto* native = NativeBuffer(frame);
+    if (native && device_) {
+      hr = MFCreateDXGISurfaceBuffer(__uuidof(ID3D11Texture2D), native->texture(),
+                                    native->subresource(), FALSE, &buffer);
+      if (FAILED(hr)) return hr;
+      hr = buffer->SetCurrentLength(size);
+      if (FAILED(hr)) return hr;
+    } else {
+      hr = MFCreateMemoryBuffer(size, &buffer);
+      if (FAILED(hr)) return hr;
+      BYTE* bytes = nullptr;
+      hr = buffer->Lock(&bytes, nullptr, nullptr);
+      if (FAILED(hr)) return hr;
+      int converted = 0;
+      // WebRTC typed getters CHECK the format; they are not nullable probes.
+      const auto* nv12 = frame.video_frame_buffer()->type() == VideoFrameBuffer::Type::kNV12
+          ? frame.video_frame_buffer()->GetNV12() : nullptr;
+    if (nv12) {
+      for (int row = 0; row < height_; ++row)
+        memcpy(bytes + row * width_, nv12->DataY() + row * nv12->StrideY(), width_);
+      for (int row = 0; row < height_ / 2; ++row)
+        memcpy(bytes + width_ * height_ + row * width_, nv12->DataUV() + row * nv12->StrideUV(), width_);
+    } else {
+      auto i420 = frame.video_frame_buffer()->ToI420();
+      if (!i420) { buffer->Unlock(); return E_FAIL; }
+      // Convert directly into the MFT-owned input sample. No temporary NV12 copy.
+      converted = libyuv::I420ToNV12(i420->DataY(), i420->StrideY(),
+          i420->DataU(), i420->StrideU(), i420->DataV(), i420->StrideV(),
+          bytes, width_, bytes + width_ * height_, width_, width_, height_);
+    }
+      buffer->Unlock();
+      if (converted != 0) return E_FAIL;
+      buffer->SetCurrentLength(size);
+    }
+    sample->AddBuffer(buffer.Get());
+    const LONGLONG time = next_time_;
+    next_time_ += 10000000 / fps_;
+    sample->SetSampleTime(time);
+    sample->SetSampleDuration(10000000 / fps_);
+    hr = encoder_->ProcessInput(input_id_, sample.Get(), 0);
+    if (FAILED(hr)) {
+      RTC_LOG(LS_WARNING) << "WebDesk MF H264 ProcessInput HRESULT=" << static_cast<long>(hr);
+      return hr;
+    }
+    texture_active_ = native != nullptr && device_ != nullptr;
+    timings_[time] = {frame.rtp_timestamp(), frame.timestamp_us(), frame.ntp_time_ms(),
+                     std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch()).count(),
+                     frame.video_frame_buffer(), key};
+    return S_OK;
+  }
+
+  HRESULT Output() {
+    MFT_OUTPUT_STREAM_INFO info{};
+    HRESULT hr = encoder_->GetOutputStreamInfo(output_id_, &info);
+    if (FAILED(hr)) return hr;
+    const bool provides = (info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES) != 0;
+    ComPtr<IMFSample> supplied;
+    if (!provides) {
+      hr = MFCreateSample(&supplied);
+      if (FAILED(hr)) return hr;
+      ComPtr<IMFMediaBuffer> buffer;
+      hr = MFCreateMemoryBuffer(std::max<DWORD>(info.cbSize, width_ * height_ * 2), &buffer);
+      if (FAILED(hr)) return hr;
+      supplied->AddBuffer(buffer.Get());
+    }
+    MFT_OUTPUT_DATA_BUFFER data{};
+    data.dwStreamID = output_id_;
+    data.pSample = supplied.Get();
+    DWORD status = 0;
+    hr = encoder_->ProcessOutput(0, 1, &data, &status);
+    ComPtr<IMFCollection> event_collection;
+    event_collection.Attach(data.pEvents);
+    ComPtr<IMFSample> owned;
+    if (provides) owned.Attach(data.pSample);
+    if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+      RTC_LOG(LS_INFO) << "WebDesk MF H264 output stream change";
+      if (++stream_changes_ > 2) return E_FAIL;
+      hr = RenegotiateOutput();
+      if (FAILED(hr)) return hr;
+      // Async transforms consume their HaveOutput event even on stream change;
+      // calling ProcessOutput again without a fresh event yields E_UNEXPECTED.
+      return async_ ? S_OK : Output();
+    }
+    if (FAILED(hr)) {
+      RTC_LOG(LS_WARNING) << "WebDesk MF H264 ProcessOutput HRESULT=" << static_cast<long>(hr);
+      return hr;
+    }
+    IMFSample* sample = provides ? owned.Get() : supplied.Get();
+    if (!sample) return E_FAIL;
+    ComPtr<IMFMediaBuffer> buffer;
+    hr = sample->ConvertToContiguousBuffer(&buffer);
+    if (FAILED(hr)) return hr;
+    BYTE* bytes = nullptr;
+    DWORD size = 0;
+    hr = buffer->Lock(&bytes, nullptr, &size);
+    if (FAILED(hr)) return hr;
+    std::vector<uint8_t> encoded;
+    const bool valid = AnnexB(std::span<const uint8_t>(bytes, size), &encoded);
+    buffer->Unlock();
+    if (!valid) return E_FAIL;
+    bool key = false, sps = false, pps = false, vcl = false;
+    if (!CacheParameters(encoded)) return E_FAIL;
+    for (const auto& nalu : H264::FindNaluIndices(encoded)) {
+      if (!nalu.payload_size) continue;
+      const int type = encoded[nalu.payload_start_offset] & 31;
+      key |= type == 5; sps |= type == 7; pps |= type == 8;
+      vcl |= type >= 1 && type <= 5;
+    }
+    // Parameter sets may be emitted separately, without consuming the input
+    // frame's timestamp/inflight texture. Keep waiting for its VCL output.
+    if (!vcl) return S_OK;
+    if (key && (!sps || !pps)) {
+      HRESULT header = ReadSequenceHeader();
+      if (FAILED(header) || sps_.empty() || pps_.empty()) return E_FAIL;
+      std::vector<uint8_t> complete;
+      if (!sps) complete.insert(complete.end(), sps_.begin(), sps_.end());
+      if (!pps) complete.insert(complete.end(), pps_.begin(), pps_.end());
+      complete.insert(complete.end(), encoded.begin(), encoded.end());
+      encoded = std::move(complete);
+    }
+    LONGLONG time = 0;
+    if (FAILED(sample->GetSampleTime(&time))) return E_FAIL;
+    auto timing = timings_.find(time);
+    if (timing == timings_.end()) return E_FAIL;
+    if (timing->second.key_requested && !key) {
+      RTC_LOG(LS_WARNING) << "WebDesk MF H264 driver did not honor IDR request; use software recovery";
+      return E_FAIL;
+    }
+    EncodedImage image;
+    image.SetEncodedData(EncodedImageBuffer::Create(encoded.data(), encoded.size()));
+    image._encodedWidth = width_; image._encodedHeight = height_;
+    image.SetRtpTimestamp(timing->second.rtp);
+    image.capture_time_ms_ = timing->second.us / 1000;
+    image.ntp_time_ms_ = timing->second.ntp;
+    image._frameType = key ? VideoFrameType::kVideoFrameKey : VideoFrameType::kVideoFrameDelta;
+    image.SetSpatialIndex(0);
+    const int64_t finish = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    image.SetEncodeTime(timing->second.started_ms, finish);
+    parser_.ParseBitstream(encoded);
+    if (auto qp = parser_.GetLastSliceQp()) image.qp_ = *qp;
+    timings_.erase(timings_.begin(), std::next(timing));
+    CodecSpecificInfo codec;
+    codec.codecType = kVideoCodecH264;
+    codec.codecSpecific.H264.packetization_mode = H264PacketizationMode::NonInterleaved;
+    codec.codecSpecific.H264.temporal_idx = kNoTemporalIdx;
+    codec.codecSpecific.H264.base_layer_sync = false;
+    codec.codecSpecific.H264.idr_frame = key;
+    callback_->OnEncodedImage(image, &codec);
+    if (rate_readback_pending_ > 0 && --rate_readback_pending_ == 0) {
+      const auto actual = ReadMeanBitrate(encoder_.Get());
+      const uint32_t tolerance = std::max<uint32_t>(10000, bitrate_ / 20);
+      const uint32_t difference = actual ? (*actual > bitrate_ ? *actual - bitrate_ : bitrate_ - *actual) : UINT32_MAX;
+      if (!actual || difference > tolerance) {
+        rates_failed_ = true;
+        RTC_LOG(LS_WARNING) << "WebDesk MF H264 live bitrate unverified after two outputs; software fallback. requested="
+                            << bitrate_ << " actual=" << actual.value_or(0);
+      }
+    }
+    return S_OK;
+  }
+
+  bool CacheParameters(std::span<const uint8_t> bytes) {
+    for (const auto& nalu : H264::FindNaluIndices(bytes)) {
+      if (!nalu.payload_size) continue;
+      const size_t offset = nalu.payload_start_offset;
+      const int type = bytes[offset] & 31;
+      if (type != 7 && type != 8) continue;
+      if (type == 7) {
+        if (nalu.payload_size < 4) return false;
+        constexpr char hex[] = "0123456789abcdef";
+        std::string profile;
+        for (size_t p = offset + 1; p <= offset + 3; ++p) {
+          profile += hex[bytes[p] >> 4]; profile += hex[bytes[p] & 15];
+        }
+        if (!H264IsProfileSubsetOf({{"profile-level-id", profile}}, format_.parameters)) return false;
+      }
+      auto& parameter = type == 7 ? sps_ : pps_;
+      parameter.assign({0, 0, 0, 1});
+      parameter.insert(parameter.end(), bytes.begin() + offset,
+                       bytes.begin() + offset + nalu.payload_size);
+    }
+    return true;
+  }
+  HRESULT ReadSequenceHeader() {
+    ComPtr<IMFMediaType> output;
+    HRESULT hr = encoder_->GetOutputCurrentType(output_id_, &output);
+    if (FAILED(hr)) return hr;
+    UINT32 size = 0;
+    hr = output->GetBlobSize(MF_MT_MPEG_SEQUENCE_HEADER, &size);
+    if (FAILED(hr) || size == 0) return S_FALSE;
+    if (size > 65536) return E_FAIL;
+    std::vector<uint8_t> header(size), annex;
+    hr = output->GetBlob(MF_MT_MPEG_SEQUENCE_HEADER, header.data(), size, nullptr);
+    if (FAILED(hr)) return hr;
+    if (!AnnexB(header, &annex)) {
+      annex.clear();
+      // AVCDecoderConfigurationRecord (avcC): bounded SPS/PPS arrays with
+      // 16-bit lengths. Never copy an opaque configuration blob into RTP.
+      if (header.size() < 7 || header[0] != 1) return E_FAIL;
+      size_t offset = 6;
+      int count = header[5] & 31;
+      for (int group = 0; group < 2; ++group) {
+        for (int i = 0; i < count; ++i) {
+          if (offset + 2 > header.size()) return E_FAIL;
+          const size_t length = (header[offset] << 8) | header[offset + 1];
+          offset += 2;
+          if (!length || length > header.size() - offset) return E_FAIL;
+          annex.insert(annex.end(), {0, 0, 0, 1});
+          annex.insert(annex.end(), header.begin() + offset, header.begin() + offset + length);
+          offset += length;
+        }
+        if (group == 0) {
+          if (offset >= header.size()) return E_FAIL;
+          count = header[offset++];
+        }
+      }
+    }
+    return CacheParameters(annex) ? S_OK : E_FAIL;
+  }
+  HRESULT RenegotiateOutput() {
+    for (DWORD i = 0; i < 16; ++i) {
+      ComPtr<IMFMediaType> type;
+      HRESULT hr = encoder_->GetOutputAvailableType(output_id_, i, &type);
+      if (FAILED(hr)) return hr;
+      GUID subtype{};
+      if (FAILED(type->GetGUID(MF_MT_SUBTYPE, &subtype)) || subtype != MFVideoFormat_H264) continue;
+      UINT32 width = 0, height = 0;
+      if (SUCCEEDED(MFGetAttributeSize(type.Get(), MF_MT_FRAME_SIZE, &width, &height)) &&
+          (width != static_cast<UINT32>(width_) || height != static_cast<UINT32>(height_))) continue;
+      hr = encoder_->SetOutputType(output_id_, type.Get(), 0);
+      if (SUCCEEDED(hr)) return ReadSequenceHeader();
+    }
+    return E_FAIL;
+  }
+
+  HRESULT Pump() {
+    ComPtr<IMFMediaEvent> event;
+    HRESULT hr = events_->GetEvent(MF_EVENT_FLAG_NO_WAIT, &event);
+    if (FAILED(hr)) return hr;
+    HRESULT status = S_OK;
+    event->GetStatus(&status);
+    if (FAILED(status)) {
+      RTC_LOG(LS_WARNING) << "WebDesk MF H264 event status HRESULT=" << static_cast<long>(status);
+      return status;
+    }
+    MediaEventType type;
+    hr = event->GetType(&type);
+    if (FAILED(hr)) return hr;
+    if (type == METransformNeedInput) input_requests_ = std::min(input_requests_ + 1, 8);
+    if (type == METransformHaveOutput) return Output();
+    return type == MEError ? E_FAIL : S_OK;
+  }
+  HRESULT EncodeFrame(const VideoFrame& frame, bool key) {
+    if (const auto* native = NativeBuffer(frame); native && !gpu_rejected_) {
+      ComPtr<ID3D11Device> device;
+      native->texture()->GetDevice(&device);
+      if (device.Get() != device_.Get()) {
+        // A source switch may change GPU adapter. Reset the MFT with the exact
+        // capture device rather than guessing a default adapter/vendor.
+        Cleanup();
+        HRESULT hr = Initialize(device.Get());
+        if (FAILED(hr)) {
+          Cleanup();
+          gpu_rejected_ = true;
+          hr = Initialize();
+        }
+        if (FAILED(hr)) return hr;
+        active_ = true;
+        key = true;
+      }
+    }
+    const auto deadline = std::chrono::steady_clock::now() + kMftDeadline;
+    stream_changes_ = 0;
+    if (timings_.size() >= kMaxPending) return MF_E_NOTACCEPTING;
+    if (async_) {
+      int events = 0;
+      while (input_requests_ == 0) {
+        if (++events > 256 || std::chrono::steady_clock::now() >= deadline) return E_FAIL;
+        HRESULT hr = Pump();
+        if (hr == MF_E_NO_EVENTS_AVAILABLE) { Sleep(1); continue; }
+        if (FAILED(hr)) return hr;
+      }
+      --input_requests_;
+    }
+    if (key) {
+      const HRESULT requested = SetCodecValue(encoder_.Get(), CODECAPI_AVEncVideoForceKeyFrame, 1);
+      RTC_LOG(LS_INFO) << "WebDesk MF H264 keyframe request HRESULT=" << static_cast<long>(requested);
+      if (requested != S_OK) return E_FAIL;
+    }
+    HRESULT hr = Submit(frame, key);
+    if (FAILED(hr) && device_) {
+      // Texture interop can fail after successful initialization. Retry the
+      // same input once as CPU NV12, then let the same-codec wrapper fall back.
+      Cleanup(); gpu_rejected_ = true;
+      hr = Initialize();
+      if (FAILED(hr)) return hr;
+      active_ = true;
+      return EncodeFrame(frame, true);
+    }
+    if (FAILED(hr)) return hr;
+    // Low latency: collect this frame before returning, with a bounded poll.
+    // Driver COM calls themselves cannot be preempted by this deadline.
+    int events = 0;
+    while (!timings_.empty()) {
+      if (++events > 256 || std::chrono::steady_clock::now() >= deadline) return E_FAIL;
+      hr = async_ ? Pump() : Output();
+      if (hr == MF_E_NO_EVENTS_AVAILABLE || hr == MF_E_TRANSFORM_NEED_MORE_INPUT) { Sleep(1); continue; }
+      if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+  }
+  void Cleanup() {
+    active_ = false;
+    texture_active_ = false;
+    if (encoder_) {
+      encoder_->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+      encoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+      encoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_STREAMING, 0);
+    }
+    events_.Reset(); encoder_.Reset(); manager_.Reset(); device_.Reset(); timings_.clear();
+    sps_.clear(); pps_.clear();
+    input_requests_ = 0; next_time_ = 0; first_ = true; paused_ = false; rates_failed_ = false;
+    rate_readback_pending_ = 0;
+    if (mf_) MFShutdown(); mf_ = false;
+    if (com_) CoUninitialize(); com_ = false;
+  }
+  static const DesktopD3D11Buffer* NativeBuffer(const VideoFrame& frame) {
+    const auto& buffer = frame.video_frame_buffer();
+    if (buffer->type() != VideoFrameBuffer::Type::kNative ||
+        buffer->storage_representation() != "WebDesk.D3D11.NV12") return nullptr;
+    const auto* native = static_cast<const DesktopD3D11Buffer*>(buffer.get());
+    if (!native->texture()) return nullptr;
+    D3D11_TEXTURE2D_DESC desc{};
+    native->texture()->GetDesc(&desc);
+    if (desc.Format != DXGI_FORMAT_NV12 || desc.Width != static_cast<UINT>(frame.width()) ||
+        desc.Height != static_cast<UINT>(frame.height()) ||
+        native->subresource() >= desc.ArraySize * desc.MipLevels) return nullptr;
+    return native;
+  }
+  SdpVideoFormat format_;
+  std::unique_ptr<Thread> thread_;
+  EncodedImageCallback* callback_ = nullptr;
+  std::atomic<bool> active_{false};
+  std::atomic<bool> texture_active_{false};
+  bool com_ = false, mf_ = false, async_ = false, first_ = true, paused_ = false;
+  bool gpu_rejected_ = false;
+  bool rates_failed_ = false;
+  int rate_readback_pending_ = 0;
+  int width_ = 0, height_ = 0, input_requests_ = 0;
+  int stream_changes_ = 0;
+  uint32_t fps_ = 30, bitrate_ = 1000000;
+  DWORD input_id_ = 0, output_id_ = 0;
+  LONGLONG next_time_ = 0;
+  ComPtr<IMFTransform> encoder_;
+  ComPtr<IMFDXGIDeviceManager> manager_;
+  ComPtr<ID3D11Device> device_;
+  ComPtr<IMFMediaEventGenerator> events_;
+  std::map<LONGLONG, Timing> timings_;
+  std::vector<uint8_t> sps_, pps_;
+  H264BitstreamParser parser_;
+};
+
+class HardwareFactory final : public VideoEncoderFactory {
+ public:
+  explicit HardwareFactory(std::unique_ptr<VideoEncoderFactory> software)
+      : software_(std::move(software)), fallback_factory_(CreateBuiltinVideoEncoderFactory()) {
+    WebDeskHasHardwareH264();
+  }
+  std::vector<SdpVideoFormat> GetSupportedFormats() const override { return software_->GetSupportedFormats(); }
+  std::unique_ptr<VideoEncoder> Create(const Environment& env, const SdpVideoFormat& format) override {
+    if (!WebDeskHasHardwareH264() || !WebDeskHardwareH264Format(format))
+      return software_->Create(env, format);
+    // The wrapped factory may itself be Intel MSDK. Select an explicitly
+    // builtin software fallback rather than accidentally wrapping HW with HW.
+    // Builtin's SimulcastEncoderAdapter retains its internal factory pointer;
+    // the factory must live through delayed runtime fallback initialization.
+    auto software = fallback_factory_->Create(env, format);
+    if (!software) return software_->Create(env, format);
+    return CreateVideoEncoderSoftwareFallbackWrapper(env, std::move(software),
+        CreateWebDeskHardwareH264(format), /*prefer_temporal_support=*/false);
+  }
+  CodecSupport QueryCodecSupport(const SdpVideoFormat& format,
+      std::optional<std::string> scalability_mode, std::optional<Resolution> resolution) const override {
+    auto support = software_->QueryCodecSupport(format, scalability_mode, resolution);
+    // An activation probe alone cannot promise power-efficient support at an
+    // arbitrary resolution. Actual encoder stats report hardware after init.
+    return support;
+  }
+ private:
+  std::unique_ptr<VideoEncoderFactory> software_;
+  std::unique_ptr<VideoEncoderFactory> fallback_factory_;
+};
+}  // namespace
+
+bool WebDeskHardwareH264Format(const SdpVideoFormat& format) {
+  if (!absl::EqualsIgnoreCase(format.name, "H264")) return false;
+  auto packetization = format.parameters.find("packetization-mode");
+  if (packetization == format.parameters.end() || packetization->second != "1") return false;
+  auto profile = ParseSdpForH264ProfileLevelId(format.parameters);
+  return profile && MfProfile(profile->profile) != 0;
+}
+bool WebDeskHasHardwareH264() {
+  if (HardwareDisabled()) return false;
+  int initial = 0;
+  if (g_probe.compare_exchange_strong(initial, 1)) std::thread([] {
+    if (FAILED(CoInitializeEx(nullptr, COINIT_MULTITHREADED))) { g_probe = 2; return; }
+    const HRESULT startup = MFStartup(MF_VERSION, MFSTARTUP_LITE);
+    bool available = false;
+    if (SUCCEEDED(startup)) {
+      ComPtr<IMFTransform> transform;
+      available = SUCCEEDED(ActivateHardware(&transform));
+      transform.Reset();
+      MFShutdown();
+    }
+    CoUninitialize();
+    g_probe = available ? 3 : 2;
+  }).detach();
+  return g_probe.load() == 3;
+}
+bool WebDeskHardwareVideoProbeComplete() {
+  if (HardwareDisabled()) return true;
+  WebDeskHasHardwareH264();
+  return g_probe.load() >= 2;
+}
+std::unique_ptr<VideoEncoder> CreateWebDeskHardwareH264(const SdpVideoFormat& format) {
+  return std::make_unique<HardwareH264>(format);
+}
+std::unique_ptr<VideoEncoderFactory> CreateWebDeskHardwareVideoEncoderFactory(
+    std::unique_ptr<VideoEncoderFactory> software) {
+  return std::make_unique<HardwareFactory>(std::move(software));
+}
+}  // namespace webrtc
